# Copy to config.env and adjust if needed.
# config.env is gitignored.

RTSP_URL=rtsp://192.168.3.27:554/live/ch00_0
RTSP_TRANSPORT=tcp

# Web UI and API (open this from your phone on the LAN)
HTTP_LISTEN=:1984

# WebRTC UDP port; must be reachable from phones on the LAN
WEBRTC_LISTEN=:8555

# LAN address of this Pi, advertised to browsers for WebRTC
# Use the Pi IP your phone can reach.
WEBRTC_CANDIDATE=192.168.3.42:8555

STREAM_NAME=cam
RESTART_DELAY=3

# How often to probe the camera while it is powered off (seconds)
CAMERA_CHECK_INTERVAL=300
